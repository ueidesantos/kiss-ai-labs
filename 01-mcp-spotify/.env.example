# SPOTIFY_ACCESS_TOKEN
#
# Token de acesso do Spotify (Bearer token).
#
# Como obter um token rapidamente para testes:
#   1. Acesse https://developer.spotify.com/
#   2. Crie uma app ou use o "Web Console" / Get Token
#   3. Para get_currently_playing: selecione escopo user-read-currently-playing
#   4. Copie o OAuth Token gerado
#
# NÃO version o arquivo .env com o token real. Use apenas variáveis de ambiente
# no seu terminal atual. Este arquivo serve APENAS como referência de nomes.

SPOTIFY_ACCESS_TOKEN=seu-token-aqui
